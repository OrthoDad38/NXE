{
  "name": "nxe-launcher",
  "version": "1.6.0",
  "description": "NXE — New Xenia Experience, a controller-first Xenia kiosk launcher",
  "main": "main.js",
  "author": "NXE",
  "homepage": "https://github.com/OrthoDad38/project-kratos",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:windows": "electron-builder --win",
    "build:linux": "electron-builder --linux",
    "test": "node --test",
    "shortcut": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/create-shortcut.ps1"
  },
  "devDependencies": {
    "electron": "^42.0.0",
    "electron-builder": "^26.0.12"
  },
  "overrides": {
    "@electron/get": {
      "global-agent": "4.1.3"
    }
  },
  "build": {
    "appId": "org.projectkratos.launcher",
    "productName": "NXE",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "scanner.js",
      "storage.js",
      "covers.js",
      "nxe.js",
      "nxe-resources.js",
      "ui-sounds.js",
      "ui-music.js",
      "music-stream.js",
      "FFMPEG-NOTICE.md",
      "index.html",
      "renderer.js",
      "styles.css",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "asarUnpack": [
      "node_modules/ffmpeg-static/ffmpeg*"
    ],
    "nsis": {
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "NXE"
    },
    "linux": {
      "maintainer": "NXE",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Game"
    }
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0"
  }
}
